<Window x:Class="NitroLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mario Kart Nitro — Launcher"
        Width="1180" Height="820" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource FInter}" FontSize="13"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="StatBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,11"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="StatVal" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FMono}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CardIcon" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="{DynamicResource BlueSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="CardIconGlyph" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource CyanBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FRaj}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="CardDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18.75"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FRaj}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="Tag" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FInterSemi}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
        <Style x:Key="CreditHead" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FRaj}"/>
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="Foreground" Value="{DynamicResource CyanBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="CreditText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="640"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="LineHeight" Value="21.6"/>
            <Setter Property="Margin" Value="0,0,0,26"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="26,22"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Shell">

        <!-- page backdrop: the soft glows and the dark vignette of the web design -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.12,-0.1" GradientOrigin="0.12,-0.1" RadiusX="0.93" RadiusY="0.6">
                    <GradientStop Color="#29ff8c00" Offset="0"/>
                    <GradientStop Color="#00ff8c00" Offset="0.6"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="0.76" RadiusY="0.6">
                    <GradientStop Color="#14c084fc" Offset="0"/>
                    <GradientStop Color="#00c084fc" Offset="0.55"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.15,1" GradientOrigin="0.15,1" RadiusX="0.5" RadiusY="0.37">
                    <GradientStop Color="#2e7828c8" Offset="0"/>
                    <GradientStop Color="#007828c8" Offset="0.7"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.85,1" GradientOrigin="0.85,1" RadiusX="0.5" RadiusY="0.37">
                    <GradientStop Color="#1fff7800" Offset="0"/>
                    <GradientStop Color="#00ff7800" Offset="0.7"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.7071" RadiusY="0.7071">
                    <GradientStop Color="#00000000" Offset="0.4"/>
                    <GradientStop Color="#bf000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== title bar ===== -->
            <Border Grid.Row="0" Background="#f0060a13" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource LineBrush}" Padding="26,14">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="LogoImg" Width="30" Height="30" Stretch="Uniform" FlowDirection="LeftToRight"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect Color="#ff8c00" Opacity="0.45" BlurRadius="10" ShadowDepth="0"/>
                            </Image.Effect>
                        </Image>
                        <TextBlock x:Name="BrandText" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FRaj}" FontSize="17">
                            <Run Text="MARIO KART "/><Run Text="NITRO" Foreground="{DynamicResource CyanBrush}"/>
                        </TextBlock>
                        <Border x:Name="VerPill" Margin="8,0,0,0" Padding="9,3" CornerRadius="11" BorderThickness="1"
                                BorderBrush="{DynamicResource LineBrush}" VerticalAlignment="Center">
                            <TextBlock x:Name="VerText" FontFamily="{StaticResource FMono}" FontSize="10.5"
                                       Foreground="{DynamicResource TextDimBrush}"/>
                        </Border>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="{DynamicResource Bg2Brush}" BorderThickness="1"
                            BorderBrush="{DynamicResource LineBrush}" CornerRadius="11" Padding="4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="TabHome" Style="{StaticResource TabBtn}" Margin="0,0,4,0"/>
                            <ToggleButton x:Name="TabMii" Style="{StaticResource TabBtn}" Margin="0,0,4,0"/>
                            <ToggleButton x:Name="TabCredits" Style="{StaticResource TabBtn}" Margin="0,0,4,0"/>
                            <ToggleButton x:Name="TabSettings" Style="{StaticResource TabBtn}"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ===== pages ===== -->
            <Grid Grid.Row="1">

                <!-- HOME -->
                <Grid x:Name="HomePage" Margin="26,14,26,8">
                    <Grid MaxWidth="1128">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="Hero" Grid.Row="0" Margin="0,0,0,12" CornerRadius="22" BorderThickness="1"
                                BorderBrush="{DynamicResource LineBrush}" Background="#07040d">
                            <Grid>
                                <Image x:Name="BannerImg" Stretch="Uniform" FlowDirection="LeftToRight"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Rectangle x:Name="HeroFade" VerticalAlignment="Bottom" Height="220" IsHitTestVisible="False">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#000a0512" Offset="0"/>
                                            <GradientStop Color="#b80a0512" Offset="0.62"/>
                                            <GradientStop Color="#ff0a0512" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="28,0,28,22">
                                    <ProgressBar x:Name="Prog" Height="6" Minimum="0" Maximum="1000" Margin="0,0,0,12"
                                                 MinWidth="420" Visibility="Collapsed" BorderThickness="0"
                                                 Foreground="{DynamicResource BlueBrush}"
                                                 Background="{DynamicResource Bg2Brush}"/>
                                    <Border x:Name="NoticeBox" Visibility="Collapsed" Margin="0,0,0,12" Padding="14,10"
                                            CornerRadius="11" BorderThickness="1" HorizontalAlignment="Left"
                                            Background="{DynamicResource PanelHoverBrush}"
                                            BorderBrush="{DynamicResource LineStrongBrush}">
                                        <TextBlock x:Name="NoticeText" TextWrapping="Wrap" MaxWidth="760"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="PlayBtn" Style="{StaticResource PrimaryBtn}"/>
                                        <Button x:Name="CloseBtn" Style="{StaticResource GhostBtn}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StatBox}">
                                <StackPanel>
                                    <TextBlock x:Name="LabelDolphin" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="StatDolphin" Style="{StaticResource StatVal}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource StatBox}">
                                <StackPanel>
                                    <TextBlock x:Name="LabelIso" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="StatIso" Style="{StaticResource StatVal}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource StatBox}">
                                <StackPanel>
                                    <TextBlock x:Name="LabelMod" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="StatMod" Style="{StaticResource StatVal}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource StatBox}">
                                <StackPanel>
                                    <TextBlock x:Name="LabelLauncher" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="StatVersion" Style="{StaticResource StatVal}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CardPlay" Grid.Column="0" Style="{StaticResource CardBtn}" Height="127">
                                <StackPanel>
                                    <Border Style="{StaticResource CardIcon}"><TextBlock Text="▶" Style="{StaticResource CardIconGlyph}"/></Border>
                                    <TextBlock x:Name="CardPlayTitle" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="CardPlayDesc" Style="{StaticResource CardDesc}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CardSettings" Grid.Column="2" Style="{StaticResource CardBtn}" Height="127">
                                <StackPanel>
                                    <Border Style="{StaticResource CardIcon}"><TextBlock Text="⚙" Style="{StaticResource CardIconGlyph}"/></Border>
                                    <TextBlock x:Name="CardSettingsTitle" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="CardSettingsDesc" Style="{StaticResource CardDesc}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CardCredits" Grid.Column="4" Style="{StaticResource CardBtn}" Height="127">
                                <StackPanel>
                                    <Border Style="{StaticResource CardIcon}"><TextBlock Text="i" Style="{StaticResource CardIconGlyph}"/></Border>
                                    <TextBlock x:Name="CardCreditsTitle" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="CardCreditsDesc" Style="{StaticResource CardDesc}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- MII -->
                <Grid x:Name="MiiPage" Margin="26,14,26,8" Visibility="Collapsed">
                    <StackPanel MaxWidth="1128">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button x:Name="MiiBack" Style="{StaticResource BackBtn}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MiiTitle" Style="{StaticResource H2}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MiiTag" Style="{StaticResource Tag}" Margin="16,0,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock x:Name="MiiInfo" Style="{StaticResource CreditText}" Margin="0,0,0,18"/>
                                <Button x:Name="MiiOpenBtn" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- CREDITS -->
                <Grid x:Name="CreditsPage" Margin="26,14,26,8" Visibility="Collapsed">
                    <StackPanel MaxWidth="1128">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button x:Name="CreditsBack" Style="{StaticResource BackBtn}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CreditsTitle" Style="{StaticResource H2}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock x:Name="CrHead1" Style="{StaticResource CreditHead}"/>
                                <TextBlock x:Name="CrText1" Style="{StaticResource CreditText}"/>
                                <TextBlock x:Name="CrHead2" Style="{StaticResource CreditHead}"/>
                                <TextBlock x:Name="CrText2" Style="{StaticResource CreditText}"/>
                                <TextBlock x:Name="CrHead3" Style="{StaticResource CreditHead}"/>
                                <TextBlock Style="{StaticResource CreditText}">
                                    <Hyperlink x:Name="DiscordLink" Foreground="{DynamicResource Blue2Brush}" TextDecorations="None">discord.gg/wbU8vw8vJq</Hyperlink>
                                </TextBlock>
                                <TextBlock x:Name="CrHead4" Style="{StaticResource CreditHead}"/>
                                <TextBlock x:Name="CrText4" Style="{StaticResource CreditText}"/>
                                <Button x:Name="DiscordBtn" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="16" Height="12" Stretch="Uniform" Fill="#1a0800" VerticalAlignment="Center"
                                              Data="F1 M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/>
                                        <TextBlock x:Name="DiscordBtnText" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource FInterSemi}" FontSize="13.5" Foreground="#1a0800"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- SETTINGS -->
                <Grid x:Name="SettingsPage" Margin="26,14,26,8" Visibility="Collapsed">
                    <StackPanel MaxWidth="1128">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button x:Name="SettingsBack" Style="{StaticResource BackBtn}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SettingsTitle" Style="{StaticResource H2}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SettingsTag" Style="{StaticResource Tag}" Margin="16,0,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <Border Style="{StaticResource Panel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                    <TextBlock x:Name="LblDolphinPath" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="SetDolphin" Style="{StaticResource NitroText}" IsReadOnly="True" Tag="Not set"/>
                                        <Button x:Name="BrowseDolphin" Grid.Column="1" Style="{StaticResource BrowseBtn}" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                    <TextBlock x:Name="LblIsoPath" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="SetIso" Style="{StaticResource NitroText}" IsReadOnly="True" Tag="Not set"/>
                                        <Button x:Name="BrowseIso" Grid.Column="1" Style="{StaticResource BrowseBtn}" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                    <TextBlock x:Name="LblModDir" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="SetModDir" Style="{StaticResource NitroText}" IsReadOnly="True"/>
                                        <Button x:Name="BrowseModDir" Grid.Column="1" Style="{StaticResource BrowseBtn}" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                    <TextBlock x:Name="LblRes" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SetRes" Style="{StaticResource NitroText}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                                    <TextBlock x:Name="LblLang" Style="{StaticResource FieldLabel}"/>
                                    <Button x:Name="LangBtn" Style="{StaticResource SelectBtn}" HorizontalContentAlignment="Left"/>
                                    <Popup x:Name="LangPopup" PlacementTarget="{Binding ElementName=LangBtn}" Placement="Bottom"
                                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineStrongBrush}"
                                                BorderThickness="1" CornerRadius="9" Padding="4" Margin="0,4,0,0">
                                            <ListBox x:Name="LangList" Background="Transparent" BorderThickness="0" MaxHeight="300"
                                                     ItemContainerStyle="{StaticResource LangItem}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                        </Border>
                                    </Popup>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0">
                                    <CheckBox x:Name="SetFull" Style="{StaticResource NitroCheck}" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="SetAuto" Style="{StaticResource NitroCheck}"/>
                                </StackPanel>
                                <Button x:Name="SaveBtn" Grid.Row="3" Grid.Column="2" Style="{StaticResource PrimaryBtn}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ===== footer line ===== -->
            <Border Grid.Row="2" Height="11" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}"/>
        </Grid>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MarioKartNitro</AssemblyName>
    <RootNamespace>NitroLauncher</RootNamespace>
    <ApplicationIcon>..\build_assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Mario Kart Nitro</Product>
    <Description>Mario Kart Nitro</Description>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>false</TieredPGO>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <NoWarn>$(NoWarn);CS8632;CA1416</NoWarn>
  </PropertyGroup>

  <!-- One standalone exe: .NET runtime included, nothing to install. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <!-- Everything below is read at runtime from inside the exe. The Mii
       editor (web page + 3D renderer) is only unpacked when it is opened. -->
  <ItemGroup>
    <EmbeddedResource Include="..\translations.json" LogicalName="translations.json" />
    <EmbeddedResource Include="..\RFL_Res.dat" LogicalName="res/RFL_Res.dat" />
    <EmbeddedResource Include="..\starter.mii" LogicalName="res/starter.mii" />
    <EmbeddedResource Include="..\index.html" LogicalName="web/index.html" />
    <EmbeddedResource Include="..\logo.png" LogicalName="web/logo.png" />
    <EmbeddedResource Include="..\banner.png" LogicalName="web/banner.png" />
    <EmbeddedResource Include="..\fonts\*.woff2" LogicalName="web/fonts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\fonts\fonts.css" LogicalName="web/fonts/fonts.css" />
    <EmbeddedResource Include="..\mii_renderer\**\*" Exclude="..\mii_renderer\**\*.map;..\mii_renderer\**\*.md"
                      LogicalName="web/mii_renderer/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
